# 只包含变量名与说明，不要提交真实凭据。
# 复制为 .env 后填写。

# ---------- 运行 ----------
INSIGHTFLOW_ENV=local
# SQLite、来源快照、报告与产物的根目录
INSIGHTFLOW_DATA_DIR=./data
# 展示时区；内部统一存 UTC
INSIGHTFLOW_TIMEZONE=Asia/Shanghai

# ---------- 模型（OpenAI 兼容 /chat/completions）----------
# 未配置 MODEL_API_KEY 时，服务端不需要模型也能跑（它是工具，不是 agent）；
# 只有 evaluation/runners/live_model.py 这个演示宿主需要它。
# 阿里百炼（DashScope 兼容模式）示例：
#   MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   MODEL_NAME=deepseek-v4.1-flash-1017
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_API_KEY=
MODEL_NAME=deepseek-chat
# 单次运行的活动时限（秒）
MODEL_TIMEOUT_SECONDS=120

# ---------- 搜索（Tavily）----------
TAVILY_API_KEY=
TAVILY_SEARCH_ENDPOINT=https://api.tavily.com/search

# ---------- GitHub Releases（可选；无 token 时受限流约束）----------
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com

# ---------- 网络与抓取 ----------
USER_AGENT=InsightFlow/0.1 (+research agent; contact: you@example.com)
HTTP_TIMEOUT_SECONDS=20
# 单页最大读取体积（字节）
FETCH_MAX_BYTES=3000000